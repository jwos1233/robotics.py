# Copy to .env for local development. .env is gitignored and must never be
# committed. On Railway these are set as service variables instead.

# Supplied by the Railway Postgres plugin. Never hardcode a real URL here.
DATABASE_URL=postgresql://user:password@localhost:5432/robotics_radar

# --- Source credentials -------------------------------------------------
# Every one of these is unverified: Phase 0 could not reach the providers, so
# whether each is required, and at what request volume, is still open.

# US Census international trade API.
CENSUS_API_KEY=

# UN Comtrade (breadth source, added after Census and Comext).
COMTRADE_API_KEY=

# Japan e-Stat. Requires a registered appId.
ESTAT_APP_ID=

# Korea data.go.kr trade statistics.
DATA_GO_KR_KEY=

# Equity price provider. No provider is selected yet -- the non-US universe
# (China A-shares in particular) is the binding constraint on the choice.
EQUITY_API_KEY=

# --- Application --------------------------------------------------------
# ACWI, not SPY. A ~70% non-US board measured against a USD-only benchmark is
# a currency bet wearing a constraint costume.
BENCHMARK_SYMBOL=ACWI
MAX_FORWARD_FILL_SESSIONS=3
LOG_LEVEL=INFO
APP_ENV=development
